# Copy to .env.local and set your OpenAI key.
# Existing environment variables take precedence over this file.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=

# Runtime defaults. The current price tables support Luna only.
OPENAI_MODEL=gpt-5.6-luna
AGENT_BUDGET_USD=5
AGENT_ARTIFACT_DIR=artifacts

# Optional browser settings. Defaults use a visible browser and a persistent profile.
# AGENT_BROWSER_HEADED=1
# AGENT_BROWSER_CHANNEL=chrome
# AGENT_BROWSER_PROFILE_DIR=artifacts/profiles/default
# AGENT_BROWSER_CDP_ENDPOINT=http://127.0.0.1:9222
# PLAYWRIGHT_CLI_COMMAND=npx
# PLAYWRIGHT_CLI_PACKAGE=@playwright/cli@0.1.19

# Optional LangSmith metrics and status. Restart the agent after changing these.
# Task text, page content, tool arguments, and user answers are excluded.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=sp-solution-test-assignment
